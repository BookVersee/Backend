{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=BookManagementDb;User Id=sa;Password=[YOUR_DB_PASSWORD];TrustServerCertificate=True;"
  },
  "JwtOptions": {
    "Issuer": "BookManagementApi",
    "Audience": "BookManagementClient",
    "SecretKey": "[YOUR_JWT_SECRET_KEY_MIN_32_CHARS]",
    "ExpireMinutes": 60
  },
  "EmailOptions": {
    "SenderEmail": "bookverse036@gmail.com",
    "SenderName": "BookVerse System",
    "ClientId": "[YOUR_EMAIL_CLIENT_ID]",
    "ClientSecret": "[YOUR_EMAIL_CLIENT_SECRET]",
    "RefreshToken": "[YOUR_EMAIL_REFRESH_TOKEN]"
  },
  "GoogleAuth": {
    "ClientId": "[YOUR_GOOGLE_CLIENT_ID]"
  },
  "VnPay": {
    "TmnCode": "[YOUR_VNPAY_TMN_CODE]",
    "HashSecret": "[YOUR_VNPAY_HASH_SECRET]",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "Version": "2.1.0",
    "Command": "pay",
    "CurrCode": "VND",
    "Locale": "vn",
    "ReturnUrl": "http://localhost:5226/api/payment/vnpay/callback"
  },
  "Ghn": {
    "ApiUrl": "https://dev-online-gateway.ghn.vn/shiip/public-api/v2",
    "Token": "[YOUR_GHN_TOKEN]",
    "ShopId": 0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Momo": {
    "ApiUrl": "https://test-payment.momo.vn/v2/gateway/api/create",
    "PartnerCode": "[YOUR_MOMO_PARTNER_CODE]",
    "AccessKey": "[YOUR_MOMO_ACCESS_KEY]",
    "SecretKey": "[YOUR_MOMO_SECRET_KEY]",
    "RedirectUrl": "http://localhost:3000/payment-result",
    "IpnUrl": "http://localhost:5226/api/payment/momo/ipn",
    "RequestType": "captureWallet"
  },
  "CloudinarySettings": {
    "CloudName": "[YOUR_CLOUDINARY_CLOUD_NAME]",
    "ApiKey": "[YOUR_CLOUDINARY_API_KEY]",
    "ApiSecret": "[YOUR_CLOUDINARY_API_SECRET]"
  }
}