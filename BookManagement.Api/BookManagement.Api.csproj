<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BookManagement.Repository\BookManagement.Repository.csproj" />
    <ProjectReference Include="..\BookManagement.Service\BookManagement.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Controllers\AdminController.cs;Controllers\AuthController.cs;Controllers\BookController.cs;Controllers\CartController.cs;Controllers\CategoryController.cs;Controllers\FeedbackController.cs;Controllers\NotificationController.cs;Controllers\OrderController.cs;Controllers\UserController.cs" />
    <EmbeddedResource Remove="Controllers\AdminController.cs;Controllers\AuthController.cs;Controllers\BookController.cs;Controllers\CartController.cs;Controllers\CategoryController.cs;Controllers\FeedbackController.cs;Controllers\NotificationController.cs;Controllers\OrderController.cs;Controllers\UserController.cs" />
    <None Remove="Controllers\AdminController.cs;Controllers\AuthController.cs;Controllers\BookController.cs;Controllers\CartController.cs;Controllers\CategoryController.cs;Controllers\FeedbackController.cs;Controllers\NotificationController.cs;Controllers\OrderController.cs;Controllers\UserController.cs" />
  </ItemGroup>
</Project>
